# Copy this file to .env and adjust as needed.
# .env.example is safe to commit; .env itself is gitignored and must never contain real secrets in git history.

ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://terminal:terminal@localhost:5433/terminal_assistant
TEST_DATABASE_URL=postgresql+psycopg://terminal:terminal@localhost:5433/terminal_assistant_test

CHUNK_SIZE=500
CHUNK_OVERLAP=50
